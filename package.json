{
  "name": "hondjes",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "nub@0.6.0",
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.6.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "start:build": "next build && next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "install": "nub install --node-linker hoisted",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@nubjs/types": ">=0.4.13 <=0.6.0",
    "@types/next": "^9.0.0",
    "@types/node": "^26",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "typescript": "^7",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "engines": {
    "node": ">=26.5.1"
  }
}

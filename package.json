{
  "name": "hondjes",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "nub@0.7.5",
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "start:build": "next build && next start",
    "install": "nub install --node-linker hoisted",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:dev": "drizzle-kit push",
    "db:reset": "drizzle-kit drop && drizzle-kit push",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@nubjs/types": ">=0.4.13 <=0.6.0",
    "@testing-library/react": "^16.3.2",
    "@types/next": "^9.0.0",
    "@types/node": "^26",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "typescript": "^7",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.12",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-qr-code": "^2.2.0"
  },
  "engines": {
    "node": ">=26.5.1"
  },
  "allowBuilds": {
    "sharp": true
  }
}
